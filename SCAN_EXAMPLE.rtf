def init_db(conn):\
    conn.executescript("""\
        PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;\
        CREATE TABLE IF NOT EXISTS hosts (\
            ip TEXT PRIMARY KEY, hostname TEXT DEFAULT '',\
            netbios_name TEXT DEFAULT '', mac TEXT DEFAULT '',\
            ptr_valid INTEGER DEFAULT 0, os_hint TEXT DEFAULT '',\
            ping_ok INTEGER DEFAULT 0, rtt_ms REAL, distance_km REAL,\
            device_type TEXT DEFAULT '', evidence TEXT DEFAULT '',\
            open_ports TEXT DEFAULT '', scanned_at TEXT NOT NULL,\
            scan_status TEXT DEFAULT 'complete',\
            scanned_with_bruteforce INTEGER DEFAULT 0\
        );\
        CREATE TABLE IF NOT EXISTS services (\
            ip TEXT NOT NULL, port INTEGER NOT NULL,\
            service TEXT DEFAULT '', confirmed_service TEXT DEFAULT '',\
            confirmation_desc TEXT DEFAULT '', banner TEXT DEFAULT '',\
            http_status TEXT DEFAULT '', server_header TEXT DEFAULT '',\
            page_title TEXT DEFAULT '', tls_subject TEXT DEFAULT '',\
            tls_issuer TEXT DEFAULT '', observed_at TEXT NOT NULL,\
            PRIMARY KEY (ip, port),\
            FOREIGN KEY (ip) REFERENCES hosts(ip) ON DELETE CASCADE\
        );\
        CREATE TABLE IF NOT EXISTS discovered (\
            ip TEXT PRIMARY KEY, beacon_port INTEGER, method TEXT DEFAULT 'tcp',\
            rtt_ms REAL, discovered_at TEXT NOT NULL\
        );\
        CREATE TABLE IF NOT EXISTS enrichment (\
            ip TEXT PRIMARY KEY, data TEXT NOT NULL,\
            updated_at TEXT NOT NULL\
        );\
        CREATE TABLE IF NOT EXISTS credentials_found (\
            ip TEXT NOT NULL, port INTEGER NOT NULL, protocol TEXT NOT NULL,\
            username TEXT NOT NULL, password TEXT NOT NULL,\
            device_type TEXT DEFAULT '', banner TEXT DEFAULT '',\
            found_at TEXT NOT NULL,\
            PRIMARY KEY (ip, port, protocol, username, password)\
        );\
    """)\
    conn.commit()\
    _migrate(conn, "hosts", [\
        ("netbios_name","TEXT DEFAULT ''"),("mac","TEXT DEFAULT ''"),\
        ("ptr_valid","INTEGER DEFAULT 0"),("os_hint","TEXT DEFAULT ''"),\
        ("distance_km","REAL"),("scanned_with_bruteforce","INTEGER DEFAULT 0"),\
    ])\
    _migrate(conn, "services", [\
        ("confirmed_service","TEXT DEFAULT ''"),\
        ("confirmation_desc","TEXT DEFAULT ''"),\
        ("tls_subject","TEXT DEFAULT ''"),("tls_issuer","TEXT DEFAULT ''"),\
    ])\
    conn.commit()\
\
def _migrate(conn, table, cols):\
    existing = \{r[1] for r in conn.execute(f"PRAGMA table_info(\{table\})")\}\
    for n, d in cols:\
        if n not in existing:\
            try: conn.execute(f"ALTER TABLE \{table\} ADD COLUMN \{n\} \{d\}")\
            except sqlite3.OperationalError: pass\
\
def save_discovered(conn, ip, port, method, rtt=None):\
    with conn:\
        conn.execute("""INSERT OR REPLACE INTO discovered\
            (ip, beacon_port, method, rtt_ms, discovered_at)\
            VALUES (?,?,?,?,?)""", (ip, port, method, rtt, utc_now()))\
\
def save_enrichment(conn, ip, data):\
    with conn:\
        conn.execute("""INSERT OR REPLACE INTO enrichment (ip, data, updated_at)\
                        VALUES (?,?,?)""",\
                     (ip, json.dumps(data, default=str), utc_now()))\
\
def save_host(conn, r):\
    bf = r.get("scanned_with_bruteforce", 0)\
    conn.execute("BEGIN")\
    try:\
        conn.execute("DELETE FROM services WHERE ip=?", (r["ip"],))\
        conn.execute("""INSERT INTO hosts\
            (ip, hostname, netbios_name, mac, ptr_valid, os_hint, ping_ok,\
             rtt_ms, distance_km, device_type, evidence, open_ports,\
             scanned_at, scan_status, scanned_with_bruteforce)\
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?, 'complete', ?)\
            ON CONFLICT(ip) DO UPDATE SET\
              hostname=excluded.hostname, netbios_name=excluded.netbios_name,\
              mac=excluded.mac, ptr_valid=excluded.ptr_valid,\
              os_hint=excluded.os_hint, ping_ok=excluded.ping_ok,\
              rtt_ms=excluded.rtt_ms, distance_km=excluded.distance_km,\
              device_type=excluded.device_type, evidence=excluded.evidence,\
              open_ports=excluded.open_ports, scanned_at=excluded.scanned_at,\
              scanned_with_bruteforce=excluded.scanned_with_bruteforce""",\
            (r["ip"], r["hostname"], r["netbios_name"], r.get("mac",""),\
             r["ptr_valid"], r["os_hint"], r["ping_ok"], r["rtt_ms"],\
             r["distance_km"], r["device_type"], r["evidence"],\
             r["open_ports"], r["scanned_at"], bf))\
        for s in r["services"]:\
            name, desc = r.get("confirmed_services", \{\}).get(s["port"], ("", ""))\
            conn.execute("""INSERT OR REPLACE INTO services\
                (ip, port, service, confirmed_service, confirmation_desc,\
                 banner, http_status, server_header, page_title,\
                 tls_subject, tls_issuer, observed_at)\
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?)""",\
                (s["ip"], s["port"], PORT_GUESS.get(s["port"], ""), name, desc,\
                 s["banner"], s["http_status"], s["server_header"],\
                 s["page_title"], s.get("tls_subject",""), s.get("tls_issuer",""),\
                 s["observed_at"]))\
        conn.commit()\
    except Exception:\
        conn.rollback(); raise\
\
def save_credentials(conn, creds):\
    if not creds: return\
    with conn:\
        conn.executemany("""INSERT OR REPLACE INTO credentials_found\
            (ip, port, protocol, username, password, device_type, banner, found_at)\
            VALUES (?,?,?,?,?,?,?,?)""",\
            [(c["ip"], c["port"], c["protocol"], c["username"], c["password"],\
              c["device_type"], c["banner"], c["found_at"]) for c in creds])\
\
def _atomic_write(path, content):\
    tmp = path.with_suffix(path.suffix + ".tmp")\
    with tmp.open("w", encoding="utf-8-sig") as f:\
        f.write(content)\
    os.replace(tmp, path)\
\
def _csv_str(header, rows):\
    import io\
    buf = io.StringIO()\
    w = csv.writer(buf); w.writerow(header); w.writerows(rows)\
    return buf.getvalue()\
\
def export_all(conn):\
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\
\
    _atomic_write(DISCOVERED_CSV, _csv_str(\
        ["ip","beacon_port","method","rtt_ms","discovered_at"],\
        conn.execute("SELECT ip,beacon_port,method,rtt_ms,discovered_at "\
                     "FROM discovered ORDER BY ip")))\
\
    _atomic_write(HOSTS_CSV, _csv_str(\
        ["ip","hostname","netbios_name","mac","ptr_valid","os_hint","ping_ok",\
         "rtt_ms","distance_km","device_type","open_ports","evidence","scanned_at"],\
        conn.execute("""SELECT ip,hostname,netbios_name,mac,ptr_valid,os_hint,\
                               ping_ok,rtt_ms,distance_km,device_type,\
                               open_ports,evidence,scanned_at\
                        FROM hosts WHERE ping_ok=1 OR open_ports!=''\
                        ORDER BY ip""")))\
\
    _atomic_write(CREDS_CSV, _csv_str(\
        ["ip","port","protocol","username","password","device_type","banner","found_at"],\
        conn.execute("""SELECT ip,port,protocol,username,password,\
                               device_type,banner,found_at\
                        FROM credentials_found ORDER BY ip,port""")))\
\
    _atomic_write(ENRICH_CSV, _csv_str(\
        ["ip","data","updated_at"],\
        conn.execute("SELECT ip, data, updated_at FROM enrichment ORDER BY ip")))\
\
    # JSON export\
    hosts_json = []\
    for row in conn.execute("""SELECT ip,hostname,netbios_name,mac,ptr_valid,\
                                      os_hint,ping_ok,rtt_ms,distance_km,\
                                      device_type,open_ports,evidence,scanned_at\
                               FROM hosts WHERE ping_ok=1 OR open_ports!=''\
                               ORDER BY ip"""):\
        host = dict(zip(["ip","hostname","netbios_name","mac","ptr_valid",\
                         "os_hint","ping_ok","rtt_ms","distance_km",\
                         "device_type","open_ports","evidence","scanned_at"], row))\
        host["services"] = []\
        for svc_row in conn.execute(\
            """SELECT port,service,confirmed_service,banner,http_status,\
                      server_header,page_title,tls_subject,tls_issuer\
               FROM services WHERE ip=? ORDER BY port""", (row[0],)):\
            host["services"].append(dict(zip(\
                ["port","service","confirmed_service","banner","http_status",\
                 "server_header","page_title","tls_subject","tls_issuer"], svc_row)))\
        enr = conn.execute("SELECT data FROM enrichment WHERE ip=?", (row[0],)).fetchone()\
        host["enrichment"] = json.loads(enr[0]) if enr else \{\}\
        hosts_json.append(host)\
\
    creds_json = [dict(zip(\
        ["ip","port","protocol","username","password","device_type","banner","found_at"], row))\
        for row in conn.execute("""SELECT ip,port,protocol,username,password,\
                                          device_type,banner,found_at\
                                   FROM credentials_found ORDER BY ip,port""")]\
\
    _atomic_write(RESULTS_JSON, json.dumps(\
        \{"hosts": hosts_json, "credentials": creds_json\},\
        indent=2, ensure_ascii=False, default=str))\
\
