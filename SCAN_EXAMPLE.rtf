def ping_host(ip):\
    ping_bin = shutil.which("ping")\
    if not ping_bin:\
        return False, None, None\
    try:\
        proc = subprocess.run([ping_bin, "-n", "-c", "1", "-W", "1", ip],\
                              capture_output=True, text=True, timeout=2.2, check=False)\
    except (OSError, subprocess.TimeoutExpired):\
        return False, None, None\
    out = (proc.stdout or "") + " " + (proc.stderr or "")\
    m = re.search(r"time[=<]([0-9.]+)\\s*ms", out, re.IGNORECASE)\
    rtt = float(m.group(1)) if m else None\
    mt = re.search(r"ttl[=:]\\s*(\\d+)", out, re.IGNORECASE)\
    ttl = int(mt.group(1)) if mt else None\
    return proc.returncode == 0, rtt, ttl\
\
def os_hint_from_ttl(ttl):\
    if ttl is None: return ""\
    if ttl <= 64: return "Linux/Unix"\
    if ttl <= 128: return "Windows"\
    if ttl <= 255: return "Network/BSD"\
    return ""\
\
def try_netbios(ip, timeout=0.8):\
    try:\
        packet = (b"\\x00\\x00\\x00\\x00\\x00\\x01\\x00\\x00\\x00\\x00\\x00\\x00"\
                  b"\\x20CK" + b"A"*30 + b"\\x00\\x00\\x21\\x00\\x01")\
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\
        s.settimeout(timeout); s.sendto(packet, (ip, 137))\
        data, _ = s.recvfrom(1024); s.close()\
        if len(data) < 57: return ""\
        num = data[56]; pos = 57\
        for _ in range(num):\
            if pos + 18 > len(data): break\
            name = data[pos:pos+15].decode("ascii", errors="ignore").rstrip()\
            suffix = data[pos+15]; pos += 18\
            if name and suffix == 0x00: return name\
        return ""\
    except Exception:\
        return ""\
\
def reverse_hostname(ip):\
    try:\
        h = socket.gethostbyaddr(ip)[0]\
    except Exception:\
        return "", False\
    try:\
        return h, socket.gethostbyname(h) == ip\
    except Exception:\
        return h, False\
\
def arp_lookup(ip):\
    """Read MAC from local ARP table (only works for same subnet)."""\
    try:\
        proc = subprocess.run(["ip", "neigh", "show", ip],\
                              capture_output=True, text=True, timeout=2)\
        m = re.search(r"lladdr ([0-9a-f:]+)", proc.stdout, re.IGNORECASE)\
        return m.group(1) if m else ""\
    except Exception:\
        return ""\
\
def parse_http_response(data):\
    text = data.decode("iso-8859-1", errors="replace")\
    header, _, body = text.partition("\\r\\n\\r\\n")\
    lines = header.splitlines()\
    sl = lines[0].strip() if lines else ""\
    server = ""\
    headers = \{\}\
    for line in lines[1:]:\
        if ":" in line:\
            k, _, v = line.partition(":")\
            headers[k.strip().lower()] = v.strip()\
            if k.strip().lower() == "server":\
                server = clean_text(v, 200)\
    m = re.search(r"<title[^>]*>(.*?)</title\\s*>", body, re.I | re.S)\
    title = clean_text(re.sub(r"<[^>]+>", " ", m.group(1)), 200) if m else ""\
    return clean_text(sl, 200), server, title, headers\
