def confirm_service(port: int, banner: str) -> tuple[str, str]:\
    if not banner:\
        return "", ""\
    text = banner.strip()\
    for pattern, name, desc in SERVICE_SIGNATURES:\
        try:\
            if re.search(pattern, text, re.IGNORECASE | re.MULTILINE):\
                return name, desc\
        except re.error:\
            continue\
    return "", ""\
\
def cve_hints_for(banner: str) -> list[str]:\
    hints = []\
    for pattern, product, versions in CVE_HINTS:\
        m = re.search(pattern, banner)\
        if not m:\
            continue\
        version = m.group(1) if m.groups() else ""\
        for v, cves in versions.items():\
            if version.startswith(v):\
                hints.extend(f"\{product\} \{version\}: \{c\}" for c in cves)\
    return hints\
