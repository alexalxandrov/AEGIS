def inspect_open_port(ip, port, timeout):\
    banner = http_status = server_header = page_title = tls_subject = tls_issuer = ""\
    http_headers = \{\}\
    sock = None\
    try:\
        raw = socket.create_connection((ip, port), timeout=timeout)\
        raw.settimeout(timeout)\
        sock = raw\
        if port in TLS_PORTS:\
            ctx = ssl.create_default_context()\
            ctx.check_hostname = False\
            ctx.verify_mode = ssl.CERT_NONE\
            try:\
                sock = ctx.wrap_socket(raw, server_hostname=ip)\
                sock.settimeout(timeout)\
                cert = sock.getpeercert()\
                if cert:\
                    subj = dict(x[0] for x in cert.get("subject", []))\
                    iss = dict(x[0] for x in cert.get("issuer", []))\
                    tls_subject = subj.get("commonName", "") or subj.get("organizationName", "")\
                    tls_issuer = iss.get("commonName", "") or iss.get("organizationName", "")\
            except (ssl.SSLError, OSError, TimeoutError):\
                raw.close()\
                return \{"ip": ip, "port": port, "banner": "TLS handshake failed",\
                        "http_status": "", "server_header": "", "page_title": "",\
                        "tls_subject": "", "tls_issuer": "", "http_headers": \{\},\
                        "observed_at": utc_now()\}\
        if port in HTTP_PORTS or port in HTTPS_PORTS:\
            req = (f"GET / HTTP/1.0\\r\\nHost: \{ip\}\\r\\n"\
                   "User-Agent: InventoryScanner/4.0\\r\\nConnection: close\\r\\n\\r\\n").encode()\
            try:\
                sock.sendall(req)\
                chunks, total = [], 0\
                while total < 8192:\
                    try: chunk = sock.recv(min(2048, 8192 - total))\
                    except socket.timeout: break\
                    if not chunk: break\
                    chunks.append(chunk); total += len(chunk)\
                resp = b"".join(chunks)\
                http_status, server_header, page_title, http_headers = parse_http_response(resp)\
                first = resp.splitlines()[0] if resp.splitlines() else b""\
                banner = clean_text(first, 300)\
            except (OSError, TimeoutError):\
                banner = "HTTP connected; metadata unavailable"\
        else:\
            try: banner = clean_text(sock.recv(1024), 500)\
            except (socket.timeout, OSError, TimeoutError): banner = ""\
        return \{"ip": ip, "port": port, "banner": banner,\
                "http_status": http_status, "server_header": server_header,\
                "page_title": page_title, "tls_subject": tls_subject,\
                "tls_issuer": tls_issuer, "http_headers": http_headers,\
                "observed_at": utc_now()\}\
    except (ConnectionRefusedError, TimeoutError, OSError):\
        return None\
    finally:\
        if sock is not None:\
            try: sock.close()\
            except OSError: pass\
\
def is_likely_ephemeral(port, confirmed_name, banner):\
    if confirmed_name: return False\
    if not banner or len(banner.strip()) < 3:\
        return port >= EPHEMERAL_MIN\
    return False\
