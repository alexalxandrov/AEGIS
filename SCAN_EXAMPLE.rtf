# TARGET PARSING\
# ===========================================================================\
def download_country_cidrs(codes):\
    nets = []\
    for reg, url in RIR_URLS.items():\
        status(f"Downloading \{reg.upper()\} delegated", C.DIM)\
        try:\
            with urllib.request.urlopen(url, timeout=120) as resp:\
                text = resp.read().decode("utf-8", errors="replace")\
        except Exception as exc:\
            warn(f"\{reg\}: \{exc\}"); continue\
        for line in text.splitlines():\
            line = line.strip()\
            if not line or line.startswith("#"): continue\
            p = line.split("|")\
            if len(p) < 7: continue\
            _, cc, rtype, start, value, _d, st = p[:7]\
            if rtype != "ipv4" or st not in ("allocated","assigned"): continue\
            if cc.upper() not in codes: continue\
            try:\
                s = ipaddress.IPv4Address(start); c = int(value)\
                e = ipaddress.IPv4Address(int(s)+c-1)\
                nets.extend(ipaddress.summarize_address_range(s, e))\
            except Exception: continue\
    return list(ipaddress.collapse_addresses(nets))\
\
def parse_targets(args):\
    entries, sources = [], []\
    if args.cidr: entries.extend(args.cidr); sources.append("cli")\
    if args.targets:\
        tf = Path(args.targets).expanduser()\
        if not tf.is_file(): raise ValueError(f"File not found: \{tf\}")\
        for line in tf.read_text(encoding="utf-8").splitlines():\
            line = line.split("#",1)[0].strip()\
            if line: entries.append(line)\
        sources.append(f"file:\{tf\}")\
    if args.countries:\
        for n in download_country_cidrs(\{c.upper() for c in args.countries\}):\
            entries.append(str(n))\
        sources.append(f"countries:\{','.join(args.countries)\}")\
    if not entries: raise ValueError("Specify --cidr, --targets, or --countries.")\
    nets = []\
    for e in entries:\
        try: n = ipaddress.ip_network(e, strict=False)\
        except ValueError as exc: raise ValueError(f"Invalid '\{e\}': \{exc\}") from exc\
        if not isinstance(n, ipaddress.IPv4Network):\
            raise ValueError(f"IPv4 only: \{e\}")\
        nets.append(n)\
    return list(ipaddress.collapse_addresses(nets)), "; ".join(sources)\
\
def enumerate_targets(nets, max_hosts):\
    est = sum(n.num_addresses if n.prefixlen>=31 else max(0,n.num_addresses-2) for n in nets)\
    if est > max_hosts: raise ValueError(f"Too many addresses (\{est\}); limit \{max_hosts\}.")\
    ips = set()\
    for n in nets: ips.update(str(x) for x in n.hosts())\
    if len(ips) > max_hosts: raise ValueError(f"\{len(ips)\} addresses; limit \{max_hosts\}.")\
    return sorted(ips, key=lambda x: int(ipaddress.ip_address(x)))\
\
def parse_ports(value):\
    ports = set()\
    for part in value.split(","):\
        part = part.strip()\
        if not part: continue\
        try: p = int(part)\
        except ValueError as exc: raise argparse.ArgumentTypeError(f"Not a port: \{part\}") from exc\
        if not 1 <= p <= 65535: raise argparse.ArgumentTypeError(f"Out of range: \{p\}")\
        ports.add(p)\
    if not ports: raise argparse.ArgumentTypeError("At least one port required")\
    return sorted(ports)\
\
# ===========================================================================\
# ENV CHECK\
# ===========================================================================\
def check_env(bruteforce):\
    mods = \{"paramiko":HAVE_SSH,"ftplib":HAVE_FTP,"telnetlib":HAVE_TELNET,\
            "pymysql":HAVE_MYSQL,"psycopg2":HAVE_PG,"redis":HAVE_REDIS,\
            "pymongo":HAVE_MONGO,"impacket":HAVE_IMPACKET\}\
    missing = [n for n,ok in mods.items() if not ok]\
    masscan_ok = masscan_available()\
    root = os.geteuid() == 0\
    status(f"masscan: \{'ENABLED' if masscan_ok else ('available but not root' if shutil.which('masscan') else 'not installed')\}", C.DIM)\
    status(f"root: \{'YES' if root else 'no'\}", C.DIM)\
    if missing:\
        warn(f"missing modules: \{', '.join(missing)\}")\
        warn("install: python3 -m venv ~/scan-venv && source ~/scan-venv/bin/activate "\
             "&& pip install paramiko pymysql psycopg2-binary redis pymongo impacket")\
    if bruteforce:\
        attempted = [p for p,ok in mods.items() if ok and p not in ("impacket",)] + ["http"]\
        if not attempted: return 3\
        status(f"bruteforce: \{', '.join(attempted)\}", C.MAGENTA)\
    return 0\
\
# ===========================================================================\
# MAIN\
# ===========================================================================\
def main():\
    parser = argparse.ArgumentParser(\
        description="Full-pipeline IPv4 scanner. masscan is used automatically "\
                    "when available AND root; otherwise falls back to asyncio.")\
    tg = parser.add_mutually_exclusive_group(required=True)\
    tg.add_argument("--cidr", action="append")\
    tg.add_argument("--targets")\
    tg.add_argument("--countries", nargs="+", metavar="CC")\
\
    # Discovery\
    parser.add_argument("--beacon-ports", type=parse_ports,\
                        default=TCP_BEACON_DEFAULT,\
                        help="TCP beacon ports for discovery")\
    parser.add_argument("--udp-beacon-ports", type=parse_ports,\
                        default=UDP_BEACON_DEFAULT,\
                        help="UDP beacon ports (only used with masscan)")\
    parser.add_argument("--concurrency", type=int, default=1000)\
    parser.add_argument("--icmp-fallback", action="store_true")\
    parser.add_argument("--no-masscan", action="store_true",\
                        help="Disable masscan even if available")\
    parser.add_argument("--masscan-rate", type=int, default=10000)\
\
    # Scan\
    parser.add_argument("--ports", type=parse_ports, default=None,\
                        help="Custom port list (default: ALL 1-65535)")\
    parser.add_argument("--quick-ports", action="store_true")\
\
    # Brute-force\
    parser.add_argument("--bruteforce", action="store_true")\
    parser.add_argument("--max-cred-attempts", type=int, default=5)\
\
    # Enrichment\
    parser.add_argument("--no-enrich", action="store_true",\
                        help="Skip SSDP/mDNS/SNMP/TLS/HTTP checks")\
    parser.add_argument("--traceroute", action="store_true",\
                        help="Include traceroute per host (slow)")\
\
    # General\
    parser.add_argument("--timeout", type=float, default=0.4)\
    parser.add_argument("--threads", type=int, default=24)\
    parser.add_argument("--max-hosts", type=int, default=65536)\
    parser.add_argument("--rescan", action="store_true")\
    args = parser.parse_args()\
\
    if not 1 <= args.threads <= 64: parser.error("--threads 1\'9664")\
    if not 0.1 <= args.timeout <= 3.0: parser.error("--timeout 0.1\'963.0")\
    if not 1 <= args.max_hosts <= 16_777_216: parser.error("--max-hosts 1\'9616777216")\
    if args.max_cred_attempts < 1: parser.error("--max-cred-attempts >= 1")\
\
    # internal: masscan_enabled = True unless --no-masscan given\
    args.masscan_enabled = not args.no_masscan\
\
    banner()\
    rc = check_env(args.bruteforce)\
    if rc != 0: return rc\
\
    try:\
        networks, source = parse_targets(args)\
        all_ips = enumerate_targets(networks, args.max_hosts)\
    except ValueError as exc:\
        error(str(exc)); return 2\
\
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\
    conn = sqlite3.connect(DB_PATH, timeout=30)\
    try:\
        init_db(conn); export_all(conn)\
\
        if args.rescan:\
            conn.execute("DELETE FROM discovered")\
            conn.execute("DELETE FROM hosts")\
            conn.execute("DELETE FROM credentials_found")\
            conn.execute("DELETE FROM enrichment")\
            conn.commit()\
            warn("--rescan: progress cleared")\
\
        frame("CONFIGURATION", C.AMBER)\
        status(f"networks: \{', '.join(str(n) for n in networks)\}")\
        status(f"addresses: \{len(all_ips)\}; source: \{source\}")\
        status(f"port scan: \{'quick' if args.quick_ports else (args.ports or 'FULL 1-65535')\}")\
        status(f"masscan: \{'enabled' if args.masscan_enabled else 'disabled'\}")\
        status(f"enrichment: \{'OFF' if args.no_enrich else 'ON (SSDP/mDNS/SNMP/TLS/HTTP/SMB)'\}")\
        status(f"bruteforce: \{'ON (after scan)' if args.bruteforce else 'OFF'\}")\
\
        # Pre-discovery enrichment: SSDP + mDNS (once for whole network)\
        global_enrich = \{"ssdp": [], "mdns": []\}\
        if not args.no_enrich:\
            status("Global SSDP/mDNS discovery", C.CYAN)\
            global_enrich["ssdp"] = ssdp_discover(timeout=3.0)\
            global_enrich["mdns"] = mdns_discover(timeout=3.0)\
            status(f"SSDP responders: \{len(global_enrich['ssdp'])\}; "\
                   f"mDNS responders: \{len(global_enrich['mdns'])\}", C.DIM)\
\
        scanned_ips = set()\
        t_start = time.time()\
\
        round1 = discovery_pass(all_ips, networks, args, conn, "ROUND 1")\
        status(f"Round 1: \{len(round1)\} alive", C.GREEN)\
        if round1:\
            frame(f"ROUND 1: FULL SCAN (\{len(round1)\} hosts)", C.AMBER)\
            for ip in sorted(round1, key=lambda x: int(ipaddress.ip_address(x))):\
                try:\
                    scan_host_full(ip, args, conn, global_enrich)\
                    scanned_ips.add(ip); export_all(conn)\
                except Exception as exc:\
                    error(f"\{ip\}: \{exc\}")\
\
        round2 = discovery_pass(all_ips, networks, args, conn, "ROUND 2")\
        new_hosts = round2 - round1\
        if new_hosts:\
            frame(f"ROUND 2: \{len(new_hosts)\} NEW HOSTS", C.GREEN)\
            for ip in sorted(new_hosts, key=lambda x: int(ipaddress.ip_address(x))):\
                try:\
                    scan_host_full(ip, args, conn, global_enrich)\
                    scanned_ips.add(ip); export_all(conn)\
                except Exception as exc:\
                    error(f"\{ip\}: \{exc\}")\
            round3 = discovery_pass(all_ips, networks, args, conn, "ROUND 3")\
            newest = round3 - round2\
            if newest:\
                warn(f"Round 3: \{len(newest)\} MORE appeared: \{sorted(newest)\}")\
                for ip in sorted(newest, key=lambda x: int(ipaddress.ip_address(x))):\
                    try:\
                        scan_host_full(ip, args, conn, global_enrich)\
                        scanned_ips.add(ip); export_all(conn)\
                    except Exception as exc:\
                        error(f"\{ip\}: \{exc\}")\
            else:\
                status("Round 3: network stable", C.GREEN)\
        else:\
            status("Round 2: no new hosts", C.GREEN)\
\
        export_all(conn)\
        elapsed = time.time() - t_start\
\
        frame("SCAN COMPLETE", C.GREEN)\
        status(f"elapsed: \{elapsed:.1f\}s")\
        status(f"hosts scanned: \{len(scanned_ips)\}")\
        total_confirmed = conn.execute(\
            "SELECT COUNT(*) FROM services WHERE confirmed_service != ''").fetchone()[0]\
        total_creds = conn.execute("SELECT COUNT(*) FROM credentials_found").fetchone()[0]\
        total_cves = 0\
        for (data,) in conn.execute("SELECT data FROM enrichment"):\
            try:\
                total_cves += len(json.loads(data).get("cves", []))\
            except Exception:\
                pass\
        status(f"confirmed services: \{total_confirmed\}", C.CYAN)\
        status(f"CVE hints: \{total_cves\}", C.AMBER if total_cves else C.DIM)\
        status(f"credentials found: \{total_creds\}",\
               C.RED if total_creds else C.DIM)\
        cprint(f"\\n  CSV: \{DISCOVERED_CSV\}", C.DIM)\
        cprint(f"       \{HOSTS_CSV\}", C.DIM)\
        cprint(f"       \{CREDS_CSV\}", C.DIM)\
        cprint(f"       \{ENRICH_CSV\}", C.DIM)\
        cprint(f"  JSON: \{RESULTS_JSON\}", C.DIM)\
        cprint(f"  DB: \{DB_PATH\}\\n", C.DIM)\
        return 0\
    finally:\
        conn.close()\
\
if __name__ == "__main__":\
    try:\
        sys.exit(main())\
    except KeyboardInterrupt:\
        cprint("\\n[!] Interrupted \'97 progress saved in SQLite.", C.AMBER)\
        sys.exit(130)}