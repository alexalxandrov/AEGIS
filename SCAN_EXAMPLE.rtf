def try_http_login(ip, port, timeout, max_attempts):\
    def _probe(auth):\
        try:\
            conn = http.client.HTTPConnection(ip, port, timeout=timeout)\
            h = \{"User-Agent": "InventoryScanner/4.0"\}\
            if auth: h["Authorization"] = auth\
            conn.request("GET", "/", headers=h)\
            r = conn.getresponse(); body = r.read(4096)\
            hdrs = \{k.lower(): v for k, v in r.getheaders()\}\
            st = r.status; conn.close()\
            return st, hdrs, body\
        except Exception:\
            return -1, \{\}, b""\
    anon_st, anon_h, anon_b = _probe(None)\
    if anon_st not in (200, 401, 403):\
        return []\
    needs_auth = anon_st in (401, 403)\
    has_form = b"<form" in anon_b.lower() and b"password" in anon_b.lower()\
    if not needs_auth and not has_form:\
        return []\
    for user, pwd in DEFAULT_CREDENTIALS["http"][:max_attempts]:\
        token = base64.b64encode(f"\{user\}:\{pwd\}".encode()).decode()\
        st, h, body = _probe(f"Basic \{token\}")\
        if needs_auth and st == 200:\
            return [(user, pwd)]\
        if not needs_auth and st in (200, 302, 303):\
            if "set-cookie" in h and "set-cookie" not in anon_h:\
                return [(user, pwd)]\
            if st in (302, 303) and any(x in h.get("location", "").lower()\
                                         for x in ("dashboard","index","home")):\
                return [(user, pwd)]\
            if b"<form" not in body.lower() and b"password" not in body.lower():\
                return [(user, pwd)]\
    return []\
\
def try_ssh(ip, port, timeout, max_attempts):\
    if not HAVE_SSH: return []\
    for user, pwd in DEFAULT_CREDENTIALS["ssh"][:max_attempts]:\
        c = paramiko.SSHClient(); c.set_missing_host_key_policy(paramiko.AutoAddPolicy())\
        try:\
            c.connect(ip, port=port, username=user, password=pwd, timeout=timeout,\
                      allow_agent=False, look_for_keys=False)\
            c.close(); return [(user, pwd)]\
        except Exception:\
            continue\
    return []\
\
def try_telnet(ip, port, timeout, max_attempts):\
    if not HAVE_TELNET: return []\
    for user, pwd in DEFAULT_CREDENTIALS["telnet"][:max_attempts]:\
        try:\
            tn = telnetlib.Telnet(ip, port, timeout=timeout)\
            tn.read_until(b"login:", timeout=timeout); tn.write(user.encode()+b"\\n")\
            tn.read_until(b"Password:", timeout=timeout); tn.write(pwd.encode()+b"\\n")\
            r = tn.read_some(); tn.close()\
            if b"incorrect" not in r.lower() and b"failed" not in r.lower():\
                return [(user, pwd)]\
        except Exception:\
            continue\
    return []\
\
def try_ftp(ip, port, timeout, max_attempts):\
    if not HAVE_FTP: return []\
    for user, pwd in DEFAULT_CREDENTIALS["ftp"][:max_attempts]:\
        try:\
            f = ftplib.FTP(); f.connect(ip, port, timeout=timeout)\
            f.login(user, pwd); f.quit(); return [(user, pwd)]\
        except Exception:\
            continue\
    return []\
\
def try_mysql(ip, port, timeout, max_attempts):\
    if not HAVE_MYSQL: return []\
    for user, pwd in DEFAULT_CREDENTIALS["mysql"][:max_attempts]:\
        try:\
            c = pymysql.connect(host=ip, port=port, user=user, password=pwd,\
                                connect_timeout=max(1, int(timeout)))\
            c.close(); return [(user, pwd)]\
        except Exception:\
            continue\
    return []\
\
def try_postgresql(ip, port, timeout, max_attempts):\
    if not HAVE_PG: return []\
    for user, pwd in DEFAULT_CREDENTIALS["postgresql"][:max_attempts]:\
        try:\
            c = psycopg2.connect(host=ip, port=port, user=user, password=pwd,\
                                 connect_timeout=max(1, int(timeout)))\
            c.close(); return [(user, pwd)]\
        except Exception:\
            continue\
    return []\
\
def try_redis(ip, port, timeout, max_attempts):\
    if not HAVE_REDIS: return []\
    for user, pwd in DEFAULT_CREDENTIALS["redis"][:max_attempts]:\
        try:\
            r = redis.Redis(host=ip, port=port, password=pwd or None,\
                            socket_connect_timeout=timeout, socket_timeout=timeout)\
            r.ping(); return [(user, pwd)]\
        except Exception:\
            continue\
    return []\
\
def try_mongodb(ip, port, timeout, max_attempts):\
    if not HAVE_MONGO: return []\
    for user, pwd in DEFAULT_CREDENTIALS["mongodb"][:max_attempts]:\
        try:\
            c = pymongo.MongoClient(ip, port, username=user, password=pwd,\
                                    authSource="admin",\
                                    serverSelectionTimeoutMS=max(500, int(timeout*1000)))\
            c.admin.command("ping"); c.close(); return [(user, pwd)]\
        except Exception:\
            continue\
    return []\
\
CRED_CHECKERS = \{"ssh":try_ssh,"telnet":try_telnet,"ftp":try_ftp,\
                 "mysql":try_mysql,"postgresql":try_postgresql,\
                 "redis":try_redis,"mongodb":try_mongodb,"http":try_http_login\}\
\
def try_credentials(ip, port, protocol, timeout, max_attempts):\
    fn = CRED_CHECKERS.get(protocol)\
    if not fn: return []\
    try: return fn(ip, port, timeout, max_attempts)\
    except Exception: return []\
\
