def identify_iot(ports):\
    matches = []\
    for name, sig in IOT_FINGERPRINTS.items():\
        overlap = len(ports & sig)\
        if overlap >= 2:\
            matches.append((name, overlap))\
    matches.sort(key=lambda x: -x[1])\
    return (matches[0][0], matches[0][1]) if matches else ("", 0)\
\
def identify_device(services, confirmed_map, ping_ok):\
    confirmed_names = \{confirmed_map[p][0] for p in confirmed_map if confirmed_map[p][0]\}\
    ports = \{s["port"] for s in services\}\
    evidence = [f"\{s['port']\}/\{confirmed_map.get(s['port'], ('', ''))[0] or PORT_GUESS.get(s['port'], '?')\}: \{(s.get('banner') or '')[:80]\}"\
                for s in services]\
\
    iot_name, iot_score = identify_iot(ports)\
    if iot_name and iot_score >= 2:\
        return f"\{iot_name\} (fingerprint: \{iot_score\} ports)", " | ".join(evidence)\
\
    if "JetDirect-printer" in confirmed_names or 631 in ports:\
        kind = "Printer / print service"\
    elif "RTSP" in confirmed_names or 554 in ports:\
        kind = "RTSP device (camera/DVR)"\
    elif 3389 in ports:\
        kind = "Host with RDP (Windows)"\
    elif ports & \{445, 139\}:\
        kind = "SMB/NetBIOS host"\
    elif "MQTT" in confirmed_names:\
        kind = "MQTT/IoT"\
    elif "VNC" in confirmed_names:\
        kind = "Host with VNC"\
    elif any(db in confirmed_names for db in ("MySQL", "PostgreSQL", "MongoDB", "Redis", "MS-SQL")):\
        kind = "DB/storage server"\
    elif confirmed_names & \{"HTTP", "HTTP/2", "HTTPS"\}:\
        kind = "Web server / web UI"\
    elif "SSH" in confirmed_names or "SSH/OpenSSH" in confirmed_names:\
        kind = "SSH host (Unix/Linux)"\
    elif ports:\
        kind = "Host with open TCP services"\
    elif ping_ok:\
        kind = "Ping-only host"\
    else:\
        kind = "No response"\
    return kind, " | ".join(evidence)\
\
