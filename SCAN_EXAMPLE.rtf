def ssdp_discover(timeout=3.0):\
    """Send SSDP M-SEARCH to multicast 239.255.255.250:1900, collect UPnP devices."""\
    msg = ('M-SEARCH * HTTP/1.1\\r\\n'\
           'HOST: 239.255.255.250:1900\\r\\n'\
           'MAN: "ssdp:discover"\\r\\n'\
           'MX: 3\\r\\n'\
           'ST: ssdp:all\\r\\n\\r\\n').encode()\
    devices = []\
    try:\
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\
        s.settimeout(timeout)\
        s.sendto(msg, ("239.255.255.250", 1900))\
        end = time.time() + timeout\
        seen = set()\
        while time.time() < end:\
            try:\
                data, addr = s.recvfrom(2048)\
            except socket.timeout:\
                break\
            ip = addr[0]\
            if ip in seen: continue\
            seen.add(ip)\
            text = data.decode("utf-8", errors="replace")\
            server = re.search(r"^SERVER:\\s*(.+)$", text, re.I | re.M)\
            location = re.search(r"^LOCATION:\\s*(.+)$", text, re.I | re.M)\
            st = re.search(r"^ST:\\s*(.+)$", text, re.I | re.M)\
            devices.append(\{\
                "ip": ip,\
                "server": server.group(1).strip() if server else "",\
                "location": location.group(1).strip() if location else "",\
                "st": st.group(1).strip() if st else "",\
            \})\
        s.close()\
    except Exception as exc:\
        warn(f"SSDP failed: \{exc\}")\
    return devices\
\
def mdns_discover(timeout=3.0):\
    """Query mDNS for _services._dns-sd._udp.local (multicast)."""\
    # Minimal DNS query for PTR _services._dns-sd._udp.local\
    header = b"\\x00\\x00\\x00\\x00\\x00\\x01\\x00\\x00\\x00\\x00\\x00\\x00"\
    qname = (b"\\x09_services\\x07_dns-sd\\x04_udp\\x05local\\x00")\
    qtype = b"\\x00\\x0c\\x00\\x01"  # PTR IN\
    packet = header + qname + qtype\
    services = []\
    try:\
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\
        s.settimeout(timeout)\
        s.sendto(packet, ("224.0.0.251", 5353))\
        end = time.time() + timeout\
        seen = set()\
        while time.time() < end:\
            try:\
                data, addr = s.recvfrom(2048)\
            except socket.timeout:\
                break\
            ip = addr[0]\
            if ip in seen: continue\
            seen.add(ip)\
            # Extract readable strings from response (best-effort)\
            strings = re.findall(rb"[\\x20-\\x7e]\{4,\}", data)\
            services.append(\{"ip": ip, "strings": [s.decode("ascii") for s in strings[:8]]\})\
        s.close()\
    except Exception as exc:\
        warn(f"mDNS failed: \{exc\}")\
    return services\
\
def snmp_probe(ip, timeout=1.5):\
    """Try SNMPv1 GET sysDescr with common community strings."""\
    # Pre-built BER-encoded SNMPv1 GET sysDescr.0\
    def _packet(community: bytes) -> bytes:\
        req_id = b"\\x02\\x01\\x01"\
        get_sysdescr = b"\\x30\\x0b\\x30\\x09\\x06\\x05\\x2b\\x06\\x01\\x02\\x01\\x01\\x01\\x05\\x00"\
        pdu = b"\\xa0" + bytes([len(req_id) + len(get_sysdescr) + 6]) + req_id + b"\\x02\\x01\\x00\\x02\\x01\\x00" + get_sysdescr\
        varbind = b"\\x04" + bytes([len(community)]) + community + pdu\
        total_len = len(varbind)\
        header = b"\\x30" + (bytes([total_len]) if total_len < 128 else b"\\x81" + bytes([total_len]))\
        return header + varbind\
    for community in (b"public", b"private"):\
        try:\
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\
            s.settimeout(timeout)\
            s.sendto(_packet(community), (ip, 161))\
            data, _ = s.recvfrom(2048); s.close()\
            if data and len(data) > 20:\
                # Extract printable sysDescr from response\
                txt = clean_text(data, 200)\
                return \{"community": community.decode(), "response": txt[:120]\}\
        except Exception:\
            continue\
    return None\
\
def ntp_check(ip, timeout=1.5):\
    """NTP mode 3 (client) request \'97 indicates potential amplification if answered."""\
    try:\
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\
        s.settimeout(timeout)\
        s.sendto(b"\\x1b" + b"\\x00" * 47, (ip, 123))\
        data, _ = s.recvfrom(1024); s.close()\
        if len(data) >= 48:\
            return \{"response_len": len(data),\
                    "amplification_risk": "YES (mode6 monlist)" if len(data) > 400 else "low"\}\
    except Exception:\
        pass\
    return None\
\
def dns_recursion_check(ip, timeout=1.5):\
    """Query a third-party name (example.com) \'97 recursion check."""\
    try:\
        # Minimal DNS A query for example.com\
        pkt = (b"\\x12\\x34\\x01\\x00\\x00\\x01\\x00\\x00\\x00\\x00\\x00\\x00"\
               b"\\x07example\\x03com\\x00\\x00\\x01\\x00\\x01")\
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\
        s.settimeout(timeout)\
        s.sendto(pkt, (ip, 53))\
        data, _ = s.recvfrom(1024); s.close()\
        if len(data) > 20 and data[3] & 0x0F == 0:  # NOERROR\
            return \{"recursive": True\}\
    except Exception:\
        pass\
    return \{"recursive": False\}\
\
def tls_analysis(ip, port, timeout=2.0):\
    """Check supported TLS versions and weak ciphers."""\
    result = \{"supported_versions": [], "weak_ciphers": []\}\
    versions = [\
        ("TLSv1.0", ssl.TLSVersion.TLSv1),\
        ("TLSv1.1", ssl.TLSVersion.TLSv1_1),\
        ("TLSv1.2", ssl.TLSVersion.TLSv1_2),\
        ("TLSv1.3", ssl.TLSVersion.TLSv1_3),\
    ]\
    for label, ver in versions:\
        try:\
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)\
            ctx.check_hostname = False\
            ctx.verify_mode = ssl.CERT_NONE\
            ctx.minimum_version = ver\
            ctx.maximum_version = ver\
            with socket.create_connection((ip, port), timeout=timeout) as raw:\
                with ctx.wrap_socket(raw, server_hostname=ip) as s:\
                    result["supported_versions"].append(label)\
        except Exception:\
            pass\
    # Weak cipher check (RC4, 3DES, DES)\
    for name in ("RC4-SHA", "DES-CBC3-SHA"):\
        try:\
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)\
            ctx.check_hostname = False\
            ctx.verify_mode = ssl.CERT_NONE\
            ctx.set_ciphers(name)\
            with socket.create_connection((ip, port), timeout=timeout) as raw:\
                with ctx.wrap_socket(raw, server_hostname=ip):\
                    result["weak_ciphers"].append(name)\
        except Exception:\
            pass\
    return result\
\
def http_options_probe(ip, port, timeout=2.0):\
    """Send OPTIONS / to enumerate supported methods."""\
    try:\
        conn = http.client.HTTPConnection(ip, port, timeout=timeout)\
        conn.request("OPTIONS", "/")\
        r = conn.getresponse()\
        allow = r.getheader("Allow") or r.getheader("allow") or ""\
        conn.close()\
        return \{"allow": allow.strip()\}\
    except Exception:\
        return \{"allow": ""\}\
\
def http_security_headers(headers: dict):\
    """Return which security headers are missing."""\
    wanted = ["strict-transport-security", "content-security-policy",\
              "x-frame-options", "x-content-type-options", "referrer-policy"]\
    missing = [h for h in wanted if h not in headers]\
    return \{"missing": missing, "present": [h for h in wanted if h in headers]\}\
\
def traceroute_to(ip, max_hops=15, timeout=1.0):\
    """Simple traceroute using system binary."""\
    tr = shutil.which("traceroute")\
    if not tr:\
        return []\
    try:\
        proc = subprocess.run(\
            [tr, "-n", "-m", str(max_hops), "-w", str(int(timeout)), ip],\
            capture_output=True, text=True, timeout=max_hops * timeout + 5,\
        )\
        hops = []\
        for line in proc.stdout.splitlines():\
            m = re.match(r"\\s*(\\d+)\\s+(\\S+)", line)\
            if m:\
                hops.append(\{"hop": int(m.group(1)), "addr": m.group(2)\})\
        return hops\
    except Exception:\
        return []\
\
def smb_null_session(ip, timeout=3):\
    """Check if SMB allows null session (impacket)."""\
    if not HAVE_IMPACKET:\
        return None\
    try:\
        conn = SMBConnection(ip, ip, sess_port=445, timeout=timeout)\
        conn.login("", "")  # null session\
        shares = conn.listShares()\
        conn.logoff()\
        return \{"null_session": True, "shares": [s["shi1_netname"][:-1] for s in shares]\}\
    except Exception as exc:\
        return \{"null_session": False, "error": str(exc)[:100]\}\
\
