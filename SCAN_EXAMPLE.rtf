def print_host_report(ip, services, confirmed_map, hostname, netbios, os_hint,\
                      ping_ok, rtt, ttl, enrichment):\
    real = []; ephemeral = []\
    for s in services:\
        name = confirmed_map.get(s["port"], ("", ""))[0]\
        if is_likely_ephemeral(s["port"], name, s.get("banner", "")):\
            ephemeral.append(s["port"])\
        else:\
            real.append(s)\
\
    cprint(f"\\n\uc0\u9556 \{'\u9552 '*78\}\u9559 ", C.CYAN)\
    cprint(f"\uc0\u9553  \{C.BOLD\}HOST \{ip:<15\}\{C.RESET\}\{C.CYAN\}  \{(hostname or '(no PTR)'):<30\}", C.CYAN)\
    cprint(f"\uc0\u9568 \{'\u9552 '*78\}\u9571 ", C.CYAN)\
\
    meta = [f"ping=\{'UP' if ping_ok else 'DOWN'\}"]\
    if rtt is not None: meta.append(f"rtt=\{rtt:.1f\}ms")\
    if ttl is not None: meta.append(f"ttl=\{ttl\}")\
    if os_hint: meta.append(f"os~\{os_hint\}")\
    if netbios: meta.append(f"netbios=\{netbios\}")\
    if enrichment.get("mac"): meta.append(f"mac=\{enrichment['mac']\}")\
    cprint(f"\uc0\u9553  \{' \'b7 '.join(meta):<76\} \u9553 ", C.DIM, dim=True)\
\
    if not real:\
        cprint(f"\uc0\u9553  \{'(no identified TCP services)':<76\} \u9553 ", C.AMBER, dim=True)\
    else:\
        cprint(f"\uc0\u9567 \{'\u9472 '*78\}\u9570 ", C.CYAN)\
        cprint(f"\uc0\u9553  \{'PORT':<7\} \{'CONFIRMED':<22\} \{'GUESS':<14\} \{'BANNER':<30\} \u9553 ", C.CYAN, bold=True)\
        cprint(f"\uc0\u9567 \{'\u9472 '*78\}\u9570 ", C.CYAN)\
        for s in real:\
            port = s["port"]\
            banner = (s.get("banner") or "")[:30]\
            confirmed = confirmed_map.get(port, ("", ""))[0]\
            guess = PORT_GUESS.get(port, "?")\
            col = C.GREEN if confirmed else C.AMBER\
            cprint(f"\uc0\u9553  \{port:<7\} \{confirmed or '\'97':<22\} \{guess:<14\} \{banner:<30\} \u9553 ",\
                   col, dim=not confirmed)\
\
    if ephemeral:\
        cprint(f"\uc0\u9567 \{'\u9472 '*78\}\u9570 ", C.DIM)\
        ep_str = ",".join(str(p) for p in ephemeral)\
        cprint(f"\uc0\u9553  \{'ephemeral (ignored): ' + ep_str:<76\} \u9553 ", C.DIM, dim=True)\
\
    # Enrichment details\
    extra = []\
    if enrichment.get("ssdp"):\
        extra.append(f"UPnP: \{enrichment['ssdp'].get('server', '?')\}")\
    if enrichment.get("mdns"):\
        extra.append(f"mDNS: \{len(enrichment['mdns'])\} responders")\
    if enrichment.get("snmp"):\
        extra.append(f"SNMP: community='\{enrichment['snmp']['community']\}'")\
    if enrichment.get("ntp"):\
        extra.append(f"NTP: amp=\{enrichment['ntp']['amplification_risk']\}")\
    if enrichment.get("dns"):\
        extra.append(f"DNS recursion: \{'YES' if enrichment['dns']['recursive'] else 'no'\}")\
    if enrichment.get("tls"):\
        v = enrichment["tls"].get("supported_versions", [])\
        w = enrichment["tls"].get("weak_ciphers", [])\
        if v: extra.append(f"TLS: \{'/'.join(v)\}")\
        if w: extra.append(f"weak ciphers: \{','.join(w)\}")\
    if enrichment.get("http_security", \{\}).get("missing"):\
        extra.append(f"missing headers: \{len(enrichment['http_security']['missing'])\}")\
    if enrichment.get("http_options", \{\}).get("allow"):\
        extra.append(f"OPTIONS Allow: \{enrichment['http_options']['allow']\}")\
    if enrichment.get("smb"):\
        smb = enrichment["smb"]\
        if smb and smb.get("null_session"):\
            extra.append(f"SMB null session: YES, shares=\{smb.get('shares', [])\}")\
    if enrichment.get("cves"):\
        extra.append(f"CVE hints: \{len(enrichment['cves'])\}")\
    if enrichment.get("traceroute"):\
        extra.append(f"traceroute: \{len(enrichment['traceroute'])\} hops")\
\
    if extra:\
        cprint(f"\uc0\u9567 \{'\u9472 '*78\}\u9570 ", C.CYAN)\
        for line in extra:\
            cprint(f"\uc0\u9553  \{line:<76\} \u9553 ", C.MAGENTA)\
\
    cprint(f"\uc0\u9562 \{'\u9552 '*78\}\u9565 ", C.CYAN)\
\
# ===========================================================================\
# FULL PIPELINE PER HOST\
# ===========================================================================\
def scan_host_full(ip, args, conn, global_enrich):\
    frame(f"HOST \{ip\}", C.GREEN)\
    t0 = time.time()\
\
    # 1. Port scan\
    if args.quick_ports:\
        scan_ports = QUICK_PORTS\
        status(f"quick scan (\{len(scan_ports)\} ports)", C.DIM)\
    elif args.ports:\
        scan_ports = args.ports\
        status(f"custom scan (\{len(scan_ports)\} ports)", C.DIM)\
    else:\
        scan_ports = None\
        status("FULL scan 1-65535", C.DIM)\
\
    if scan_ports is not None:\
        sem = asyncio.Semaphore(args.concurrency)\
        async def _run():\
            async def probe(p):\
                async with sem:\
                    try:\
                        _, w = await asyncio.wait_for(\
                            asyncio.open_connection(ip, p), timeout=args.timeout)\
                        try: w.close()\
                        except Exception: pass\
                        return p\
                    except Exception:\
                        return None\
            return [p for p in await asyncio.gather(*[probe(p) for p in scan_ports])\
                    if p is not None]\
        try:\
            open_ports = sorted(asyncio.run(_run()))\
        except Exception as exc:\
            warn(f"\{ip\}: async scan failed: \{exc\}")\
            open_ports = []\
    else:\
        open_ports = full_port_scan_host(ip, args)\
\
    elapsed = time.time() - t0\
    status(f"\{len(open_ports)\} open ports in \{elapsed:.1f\}s", C.GREEN)\
\
    # 2. Service inspection + confirmation\
    services = []\
    confirmed_map = \{\}\
    for port in open_ports:\
        svc = inspect_open_port(ip, port, args.timeout)\
        if svc is None or not svc.get("banner"):\
            time.sleep(0.1)\
            retry = inspect_open_port(ip, port, min(args.timeout * 2, 2.0))\
            if retry: svc = retry\
        if svc:\
            services.append(svc)\
            name, desc = confirm_service(port, svc.get("banner", ""))\
            confirmed_map[port] = (name, desc)\
\
    # 3. Basic discovery info\
    ping_ok, rtt, ttl = ping_host(ip)\
    hostname, _ = reverse_hostname(ip)\
    netbios = try_netbios(ip) if (ping_ok or any(p in (139,137,445) for p in open_ports)) else ""\
    os_hint = os_hint_from_ttl(ttl)\
\
    # 4. Enrichment\
    enrichment = \{\
        "mac": arp_lookup(ip) if ping_ok else "",\
        "cves": [],\
        "http_headers": \{\},\
        "traceroute": [],\
    \}\
\
    if not args.no_enrich:\
        # CVE hints from banners\
        all_banners = " ".join(s.get("banner", "") or "" for s in services)\
        enrichment["cves"] = cve_hints_for(all_banners)\
\
        # SSDP per-host mapping (from global cache)\
        ssdp_for_ip = [d for d in global_enrich.get("ssdp", []) if d["ip"] == ip]\
        if ssdp_for_ip:\
            enrichment["ssdp"] = ssdp_for_ip[0]\
\
        mdns_for_ip = [d for d in global_enrich.get("mdns", []) if d["ip"] == ip]\
        if mdns_for_ip:\
            enrichment["mdns"] = mdns_for_ip[0]\
\
        # SNMP\
        if 161 in open_ports or (ping_ok and not open_ports):\
            r = snmp_probe(ip)\
            if r: enrichment["snmp"] = r\
\
        # NTP\
        if 123 in open_ports:\
            r = ntp_check(ip)\
            if r: enrichment["ntp"] = r\
\
        # DNS recursion\
        if 53 in open_ports:\
            enrichment["dns"] = dns_recursion_check(ip)\
\
        # TLS scan on first HTTPS-like port\
        for p in open_ports:\
            if p in TLS_PORTS:\
                enrichment["tls"] = tls_analysis(ip, p, timeout=min(args.timeout * 3, 3.0))\
                break\
\
        # HTTP headers/options on first HTTP port\
        http_port = next((p for p in open_ports if p in HTTP_PORTS), None)\
        if http_port:\
            enrichment["http_security"] = http_security_headers(\
                next((s["http_headers"] for s in services if s["port"] == http_port), \{\}))\
            enrichment["http_options"] = http_options_probe(ip, http_port)\
\
        # SMB null session\
        if 445 in open_ports and HAVE_IMPACKET:\
            r = smb_null_session(ip)\
            if r: enrichment["smb"] = r\
\
        # Traceroute (optional, can be slow)\
        if args.traceroute and ping_ok:\
            enrichment["traceroute"] = traceroute_to(ip)\
\
    # 5. Report\
    print_host_report(ip, services, confirmed_map, hostname, netbios, os_hint,\
                      ping_ok, rtt, ttl, enrichment)\
\
    # 6. Save\
    device_type, evidence = identify_device(services, confirmed_map, ping_ok)\
    save_host(conn, \{\
        "ip": ip, "hostname": hostname, "netbios_name": netbios,\
        "ptr_valid": 1 if hostname else 0, "os_hint": os_hint,\
        "mac": enrichment.get("mac", ""),\
        "ping_ok": int(ping_ok), "rtt_ms": rtt,\
        "distance_km": estimate_distance_km(rtt),\
        "device_type": device_type, "evidence": evidence,\
        "open_ports": ",".join(str(p) for p in open_ports),\
        "scanned_at": utc_now(), "services": services,\
        "confirmed_services": confirmed_map,\
        "scanned_with_bruteforce": 1 if args.bruteforce else 0,\
    \})\
    save_enrichment(conn, ip, enrichment)\
\
    # 7. Brute-force\
    if args.bruteforce:\
        with conn:\
            conn.execute("DELETE FROM credentials_found WHERE ip = ?", (ip,))\
        creds = []\
        for svc in services:\
            port = svc["port"]\
            confirmed_name = confirmed_map.get(port, ("", ""))[0]\
            protocol = PORT_TO_PROTOCOL.get(port)\
            if protocol is None and confirmed_name in ("HTTP","HTTP/2","HTTPS"):\
                protocol = "http"\
            if protocol and confirmed_name:\
                status(f"brute \{port\}/\{protocol\} (\{confirmed_name\})", C.MAGENTA)\
                for user, pwd in try_credentials(ip, port, protocol,\
                                                 args.timeout, args.max_cred_attempts):\
                    creds.append(\{\
                        "ip": ip, "port": port, "protocol": protocol,\
                        "username": user, "password": pwd,\
                        "device_type": device_type,\
                        "banner": svc.get("banner", ""),\
                        "found_at": utc_now(),\
                    \})\
                    cprint(f"  [!] FOUND \{user\}:\{pwd\} on \{port\}/\{protocol\}",\
                           C.RED, bold=True)\
        save_credentials(conn, creds)\
\
    return \{"ip": ip, "open_ports": open_ports,\
            "confirmed": confirmed_map, "device_type": device_type,\
            "enrichment": enrichment\}\
\
