async def _probe_tcp(ip, port, timeout, sem):\
    async with sem:\
        try:\
            _, w = await asyncio.wait_for(asyncio.open_connection(ip, port), timeout=timeout)\
        except Exception:\
            return False\
        try:\
            w.close(); await asyncio.wait_for(w.wait_closed(), timeout=0.3)\
        except Exception:\
            pass\
        return True\
\
async def _discover_one(ip, ports, timeout, sem):\
    tasks = \{asyncio.create_task(_probe_tcp(ip, p, timeout, sem)): p for p in ports\}\
    try:\
        while tasks:\
            done, pending = await asyncio.wait(tasks.keys(), return_when=asyncio.FIRST_COMPLETED)\
            for t in done:\
                if t.cancelled() or t.exception() is not None:\
                    continue\
                if t.result() is True:\
                    port = tasks[t]\
                    for p in pending: p.cancel()\
                    return port\
            tasks = \{t: tasks[t] for t in pending\}\
        return None\
    finally:\
        for t in tasks:\
            if not t.done(): t.cancel()\
\
async def _discovery_async(ips, beacon_ports, timeout, concurrency, on_found, on_progress):\
    sem = asyncio.Semaphore(concurrency)\
    found = \{\}\
    total = len(ips); done = 0\
    batch_size = max(200, concurrency * 4)\
    async def _one(ip):\
        port = await _discover_one(ip, beacon_ports, timeout, sem)\
        if port is not None:\
            found[ip] = port\
            on_found(ip, port)\
    for start in range(0, total, batch_size):\
        batch = ips[start:start + batch_size]\
        await asyncio.gather(*[_one(ip) for ip in batch])\
        done += len(batch)\
        on_progress(done, total, len(found))\
    return found\
\
def _icmp_fallback(ips, conn):\
    found = \{\}\
    if not shutil.which("ping") or not ips:\
        return found\
    status(f"ICMP fallback on \{len(ips)\} hosts", C.DIM)\
    with ThreadPoolExecutor(max_workers=min(64, len(ips))) as pool:\
        futures = \{pool.submit(ping_host, ip): ip for ip in ips\}\
        for f in as_completed(futures):\
            ip = futures[f]\
            try:\
                ok, rtt, _ = f.result()\
                if ok:\
                    found[ip] = rtt\
                    save_discovered(conn, ip, None, "icmp", rtt)\
                    cprint(f"  + \{ip\} (icmp)", C.GREEN)\
            except Exception:\
                continue\
    return found\
\
def masscan_available():\
    """masscan is usable only if binary is present AND we have root."""\
    return shutil.which("masscan") is not None and os.geteuid() == 0\
\
def _discovery_masscan(networks, tcp_ports, udp_ports, rate):\
    if not masscan_available():\
        return None\
    ports_arg = ",".join(str(p) for p in tcp_ports)\
    if udp_ports:\
        ports_arg += ",U:" + ",".join(str(p) for p in udp_ports)\
    cmd = ["masscan", "-p", ports_arg, "--rate", str(rate),\
           "-oL", "-", "--wait", "3"] + [str(n) for n in networks]\
    status(f"masscan @ \{rate\} pps (TCP+UDP)", C.CYAN)\
    try:\
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=7200)\
    except Exception as exc:\
        warn(f"masscan failed: \{exc\}"); return None\
    if proc.returncode != 0:\
        warn(f"masscan exit \{proc.returncode\}: \{(proc.stderr or '')[:200]\}")\
        return None\
    found = \{\}\
    for line in proc.stdout.splitlines():\
        p = line.split()\
        if len(p) >= 4 and p[0] == "open":\
            try:\
                port = int(p[2]); ip = p[3]\
            except (ValueError, IndexError):\
                continue\
            found.setdefault(ip, port)\
    return found\
\
def discovery_pass(ips, networks, args, conn, label):\
    frame(f"\{label\} \'97 DISCOVERY", C.CYAN)\
    already = \{ip for (ip,) in conn.execute("SELECT ip FROM discovered")\} & set(ips)\
    to_check = [ip for ip in ips if ip not in already]\
    status(f"To check: \{len(to_check)\} (known: \{len(already)\})")\
\
    if to_check:\
        use_masscan = (\
            args.masscan_enabled\
            and masscan_available()\
            and len(to_check) >= 16\
        )\
        if args.masscan_enabled and not masscan_available():\
            if shutil.which("masscan") is None:\
                status("masscan not installed \'97 using asyncio fallback", C.DIM)\
            else:\
                status("masscan needs root \'97 using asyncio fallback", C.DIM)\
\
        if use_masscan:\
            found = _discovery_masscan(networks, args.beacon_ports,\
                                       args.udp_beacon_ports, args.masscan_rate)\
            if found is not None:\
                for ip, port in found.items():\
                    save_discovered(conn, ip, port, "masscan")\
            else:\
                use_masscan = False\
\
        if not use_masscan:\
            start = time.time(); last = [0.0]\
            def on_found(ip, port):\
                save_discovered(conn, ip, port, "tcp")\
                cprint(f"  + \{ip\}:\{port\}", C.GREEN)\
            def on_progress(done, total, found_count):\
                now = time.time()\
                if now - last[0] >= 1.0 or done == total:\
                    last[0] = now\
                    progress_bar(done, total, found_count)\
            try:\
                asyncio.run(_discovery_async(to_check, args.beacon_ports,\
                                             args.timeout, args.concurrency,\
                                             on_found, on_progress))\
            except KeyboardInterrupt:\
                warn("Discovery interrupted.")\
\
        if args.icmp_fallback or len(ips) <= 1024:\
            known = \{ip for (ip,) in conn.execute("SELECT ip FROM discovered")\}\
            remaining = [ip for ip in to_check if ip not in known]\
            if remaining:\
                _icmp_fallback(remaining, conn)\
    return \{ip for (ip,) in conn.execute("SELECT ip FROM discovered")\} & set(ips)\
\
# ===========================================================================\
# FULL PORT SCAN\
# ===========================================================================\
async def _full_port_scan_async(ip, concurrency, timeout):\
    open_ports = []; sem = asyncio.Semaphore(concurrency); batch = 2000\
    async def probe(port):\
        async with sem:\
            try:\
                _, w = await asyncio.wait_for(asyncio.open_connection(ip, port), timeout=timeout)\
                try: w.close()\
                except Exception: pass\
                return port\
            except Exception:\
                return None\
    for start in range(1, 65536, batch):\
        end = min(start + batch, 65536)\
        results = await asyncio.gather(*[probe(p) for p in range(start, end)])\
        open_ports.extend(p for p in results if p is not None)\
    return sorted(open_ports)\
\
def _full_scan_masscan(ips, rate):\
    if not masscan_available():\
        return None\
    cmd = ["masscan", "-p", "1-65535", "--rate", str(rate), "-oL", "-",\
           "--wait", "3"] + ips\
    try:\
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=3600)\
    except Exception:\
        return None\
    if proc.returncode != 0: return None\
    found = \{\}\
    for line in proc.stdout.splitlines():\
        p = line.split()\
        if len(p) >= 4 and p[0] == "open":\
            try:\
                port = int(p[2]); ip = p[3]\
            except (ValueError, IndexError):\
                continue\
            found.setdefault(ip, []).append(port)\
    return found\
\
def full_port_scan_host(ip, args):\
    if args.masscan_enabled and masscan_available():\
        res = _full_scan_masscan([ip], args.masscan_rate)\
        if res is not None:\
            return sorted(res.get(ip, []))\
    try:\
        return asyncio.run(_full_port_scan_async(ip, args.concurrency, args.timeout))\
    except Exception as exc:\
        warn(f"\{ip\}: port scan failed: \{exc\}")\
        return []\
\
